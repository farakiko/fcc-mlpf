# HTCondor submit file for CLD production (lxplus).
# Before submitting:
#   1. stage this directory to EOS:         ./stage_to_eos.sh   (sets STAGING_DIR contents)
#   2. edit environment below (STAGING_DIR, OUTPUT_DIR)
#   3. mkdir -p logs/out logs/err
#   4. condor_submit run.sub
# Validate output afterwards:  python ../../validation/audit_edm4hep.py <OUTPUT_DIR>/*.edm4hep.root

executable = gen_sim_rec.sh
arguments  = "$(Cluster).$(Process) $(n_events)"

# NOTE: the running 100k campaign writes to the personal-EOS path below; do NOT change
# OUTPUT_DIR mid-campaign (skip-if-exists protection). After completion, migrate to the
# FCC shared-space policy path and use it for all future campaigns:
#   /eos/experiment/fcc/ee/simulation/key4hep_2026_04_08/365GeV/CLD_o2_v08/rec/ttbar_mlpf
# SEED_BASE: REQUIRED for new campaigns -- pick a block disjoint from campaigns/*.seeds.txt
# (see campaigns/CAMPAIGNS.md rule 2) and record the campaign in the ledger after it runs.
environment = "STAGING_DIR=/eos/user/f/fmokhtar/fcc-mlpf/production/cld OUTPUT_DIR=/eos/user/f/fmokhtar/fcc-mlpf/data/cld_tt SEED_BASE="

log    = logs/$(Cluster).log
output = logs/out/$(Cluster).$(Process).log
error  = logs/err/$(Cluster).$(Process).log

+AccountingGroup = "group_u_FCC.local_gen"
MY.WantOS = "el9"

# ~8 min / 10-event job measured (2026-09-29 reference production) -> microcentury (1 h) is safe
+JobFlavour = "microcentury"

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_input_files    = ""
transfer_output_files   = ""

# ---- scale here: n_events per job x number of jobs ----
# Production convention (2026-10-01): 10 ev/job keeps files ~34 MB (<50 MB policy) and jobs
# ~8 min; eviction-reruns are cheap (skip-if-exists). 10,000 jobs = 100k events ~ 340 GB.
# Val-split convention: first 1,000 files of the sorted output list (10%) are held out.
n_events = 10
queue 10000
